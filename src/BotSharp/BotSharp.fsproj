<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>BotSharp</RootNamespace>
    <AssemblyName>botsharp</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- FS0025: incomplete pattern match → compile error, enforcing exhaustive DU handling -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain layer – no external dependencies, must compile first -->
    <Compile Include="Domain/Types.fs" />
    <Compile Include="Domain/Errors.fs" />
    <Compile Include="Domain/StateMachine.fs" />

    <!-- Infrastructure shared utilities -->
    <Compile Include="Infrastructure/Shared/AsyncResult.fs" />
    <Compile Include="Infrastructure/Shared/Json.fs" />
    <Compile Include="Infrastructure/Shared/StringUtils.fs" />
    <Compile Include="Infrastructure/Shared/GitBlame.fs" />

    <!-- Infrastructure: parsers and adapters (compilation order matters) -->
    <Compile Include="Infrastructure/Config/ConfigParser.fs" />
    <Compile Include="Infrastructure/Config/ConfigLoader.fs" />
    <Compile Include="Infrastructure/Config/ConfigWriter.fs" />
    <Compile Include="Infrastructure/Input/InputParser.fs" />
    <Compile Include="Infrastructure/Providers/SseParser.fs" />
    <Compile Include="Infrastructure/Providers/LlmResponseParser.fs" />
    <Compile Include="Infrastructure/Providers/OpenAICompatAdapter.fs" />
    <Compile Include="Infrastructure/Providers/ProviderRegistry.fs" />
    <Compile Include="Infrastructure/Storage/SessionParser.fs" />
    <Compile Include="Infrastructure/Storage/JsonlStore.fs" />
    <Compile Include="Infrastructure/Storage/DreamStore.fs" />
    <Compile Include="Infrastructure/Storage/CronStore.fs" />
    <Compile Include="Infrastructure/Cron/CronService.fs" />
    <Compile Include="Infrastructure/Skills/DefaultSkills.fs" />
    <Compile Include="Infrastructure/Skills/SkillsLoader.fs" />
    <Compile Include="Infrastructure/Tools/ToolParser.fs" />
    <Compile Include="Infrastructure/Tools/FileSystemTool.fs" />
    <Compile Include="Infrastructure/Tools/ShellTool.fs" />
    <Compile Include="Infrastructure/Tools/WebTool.fs" />
    <Compile Include="Infrastructure/Tools/CronTool.fs" />
    <Compile Include="Infrastructure/Tools/MessageTool.fs" />
    <Compile Include="Infrastructure/Tools/NotebookTool.fs" />
    <Compile Include="Infrastructure/Tools/MyTool.fs" />
    <Compile Include="Infrastructure/Tools/McpTool.fs" />
    <Compile Include="Infrastructure/Tools/ToolHints.fs" />

    <!-- CLIPS rule engine -->
    <Compile Include="Infrastructure/Rules/ClipsNative.fs" />
    <Compile Include="Infrastructure/Rules/ClipsEnvironment.fs" />
    <Compile Include="Infrastructure/Rules/RuleEngine.fs" />
    <Compile Include="Infrastructure/Channels/ChannelBase.fs" />
    <Compile Include="Infrastructure/Channels/CliChannel.fs" />
    <Compile Include="Infrastructure/Channels/MarkdownParser.fs" />
    <Compile Include="Infrastructure/Channels/OnboardingWizard.fs" />

    <!-- Application layer -->
    <Compile Include="Application/ContextBuilder.fs" />
    <Compile Include="Application/AgentLoop.fs" />
    <Compile Include="Application/MemoryConsolidator.fs" />
    <Compile Include="Application/SessionActor.fs" />
    <Compile Include="Application/HeartbeatService.fs" />
    <Compile Include="Application/AutoCompactService.fs" />
    <Compile Include="Application/SessionCleanupService.fs" />
    <Compile Include="Application/SubagentManager.fs" />

    <!-- SpawnTool and LongTaskTool after SubagentManager (Application layer dep) -->
    <Compile Include="Infrastructure/Tools/SpawnTool.fs" />
    <Compile Include="Infrastructure/Tools/LongTaskTool.fs" />

    <!-- Telegram channel adapter (after SessionActor — uses TelegramCoordinator) -->
    <Compile Include="Infrastructure/Channels/TelegramChannel.fs" />

    <!-- OpenAI-compatible HTTP API channel (after SessionActor — uses AgentCoordinator) -->
    <Compile Include="Infrastructure/Channels/ApiChannel.fs" />

    <!-- WebSocket channel (after SessionActor — uses per-connection streaming hook) -->
    <Compile Include="Infrastructure/Channels/WsChannel.fs" />

    <!-- Discord channel (after SessionActor — uses AgentCoordinator) -->
    <Compile Include="Infrastructure/Channels/DiscordChannel.fs" />

    <!-- Inter-agent communication channel (after SessionActor — uses AgentCoordinator) -->
    <Compile Include="Infrastructure/Channels/InterAgentChannel.fs" />

    <!-- Message bus (after Application layer — depends on AgentCoordinator) -->
    <Compile Include="Infrastructure/MessageBus.fs" />

    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.19.1" />
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Include="Telegram.Bot" Version="21.*" />
  </ItemGroup>

  <!-- CLIPS native library (built via Native/build-clips.sh) -->
  <ItemGroup Condition="Exists('runtimes')">
    <Content Include="runtimes/**/libclips.*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BotSharp.Tests" />
  </ItemGroup>

</Project>
